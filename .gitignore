# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging / build artifacts (pip, setuptools, build)
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# ── PyInstaller (Windows release builds) ─────────────────────────────────
*.manifest
# keep the .spec file; ignore its output
build/
dist/

# ── Debian / Ubuntu packaging ────────────────────────────────────────────
# Generated by dpkg-buildpackage / debhelper inside debian/
debian/files
debian/*.substvars
debian/*.debhelper
debian/*.debhelper.log
debian/.debhelper/
debian/debhelper-build-stamp
debian/tmp/
debian/als162-sync/
debian/als162-sync-gui/
debian/autoreconf.*
.pybuild/

# Produced in the parent directory, but listed in case the build runs in-tree
*.deb
*.ddeb
*.udeb
*.dsc
*.changes
*.buildinfo
*.build
*.tar.xz
*.tar.gz
*.orig.tar.*
*.debian.tar.*

# Local CI output directory used by the GitHub Actions workflow
out/

# ── Project-specific runtime data ────────────────────────────────────────
# Downloaded OSM tiles (now cached in ~/.als162gps/tiles, never in the tree)
assets/tiles/
# Audio captures produced with --record
*.wav
!tests/**/*.wav

# ── Editors / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
